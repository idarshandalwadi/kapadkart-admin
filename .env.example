# ==============================================================================
# KAPADKART ADMIN — PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# Production template. Copy to .env for production builds.
# `npm run dev` loads .env.development instead, which targets the local API.
#
# Cloudflare Pages (`npm run deploy`) uses .env.production, which leaves
# VITE_API_BASE_URL empty. functions/ then proxies /api to the Lightsail API.
# Do not point a Pages build at the HTTP API host; the browser will block it.
# ==============================================================================

# Base URL Path
VITE_BASE_PATH=/

# Backend API Base URL
# - Cloudflare Pages: leave empty. functions/ proxies /api to the API.
# - Browser calling the API host directly (HTTP pages only):
#   VITE_API_BASE_URL=http://13.234.170.148/kapadkart
VITE_API_BASE_URL=

# Local Development Proxy target
VITE_BACKEND_URL=http://localhost:4000
